    "semear": "tsx ./Sementes_Iniciais/Semente_Padrao.ts",
    "estudio": "prisma studio --schema=./Esquema_Prisma/Esquema_Principal.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0"
  },
  "devDependencies": {
    "prisma": "^6.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
