{
  "name": "@gerenciador/banco-dados",
  "version": "1.0.0",
  "description": "Camada de persistência e ORM Prisma com suporte a SQLite e PostgreSQL",
  "main": "Codigo_Fonte/Cliente_Banco.ts",
  "types": "Codigo_Fonte/Cliente_Banco.ts",
  "scripts": {
    "gerar": "prisma generate --schema=./Esquema_Prisma/Esquema_Principal.prisma",
