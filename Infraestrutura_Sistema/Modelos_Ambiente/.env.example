# ==============================================================================
# CONFIGURAÇÕES GERAIS DO SISTEMA
# ==============================================================================
PORTA_API=3333
PORTA_INTERFACE=5173
PORTA_REDIS=6379
HOST_REDIS=localhost
CHAVE_SECRETA_JWT=chave_super_secreta_para_desenvolvimento_local_min_32_chars
CHAVE_CRIPTOGRAFIA_TOKENS=chave_aes_256_bits_para_criptografar_tokens_sociais_32b!

# Modo Simulado (Permite rodar 100% da plataforma sem chaves reais)
MOCK_MODE=true

# ==============================================================================
# BANCO DE DADOS
# Por padrão, usa SQLite local sem necessidade de instalar Docker ou PostgreSQL.
# Se preferir PostgreSQL: postgresql://usuario:senha@localhost:5432/gerenciador_conteudo
# ==============================================================================
DATABASE_URL="file:./dados_desenvolvimento.db"

# ==============================================================================
# ARMAZENAMENTO DE MÍDIA
# Tipos: LOCAL | S3 | MINIO
# ==============================================================================
TIPO_ARMAZENAMENTO=LOCAL
CAMINHO_ARMAZENAMENTO_LOCAL=./Armazenamento_Local

# ==============================================================================
# CREDENCIAIS OFICIAIS DE REDES SOCIAIS (Preencher apenas para conexões reais)
# ==============================================================================
# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3333/api/autenticacao/retorno/youtube"

# Meta Graph API (Instagram Professional + Facebook Pages)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3333/api/autenticacao/retorno/meta"

# TikTok Content Posting API (TikTok Developer Portal)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3333/api/autenticacao/retorno/tiktok"

# Kwai Open API (Kwai for Developers)
KWAI_APP_ID=""
KWAI_APP_SECRET=""
KWAI_REDIRECT_URI="http://localhost:3333/api/autenticacao/retorno/kwai"
